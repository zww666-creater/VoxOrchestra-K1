{
  "platform": {
    "soc": "SpacemiT K1",
    "architecture": "riscv64",
    "runtime": "Bianbu Linux"
  },
  "router": {
    "l0_keywords": ["停止", "取消", "暂停", "闭嘴", "stop", "cancel", "quit"],
    "direct_threshold": 4.5,
    "context_threshold": 2.0,
    "top_k": 2
  },
  "knowledge": "data/knowledge/knowledge.jsonl",
  "queues": {
    "text_capacity": 8,
    "pcm_capacity": 32,
    "push_timeout_ms": 50
  },
  "net": {
    "asr_audio_uplink": false
  },
  "asr": {
    "backend": "fake",
    "num_threads": 4
  },
  "llm": {
    "backend": "fake",
    "max_new_tokens": 128,
    "max_context_len": 256
  },
  "tts": {
    "backend": "fake",
    "sink": "wav"
  },
  "output_dir": "/tmp/voxorchestra-k1/session-out",
  "stage_delay_ms": 0,
  "tts_min_duration_ms": 1000,
  "max_run_ms": 30000
}
